{
  "name": "ai-buddy",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "AI Buddy desktop app (Tauri + React + TypeScript)",
  "author": {
    "name": "Go-bugi",
    "url": "https://github.com/Go-bugi"
  },
  "homepage": "https://github.com/Go-bugi/ai-buddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Go-bugi/ai-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/Go-bugi/ai-buddy/issues"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "build": "pnpm run typecheck && vite build",
    "build:unpack": "tauri build --no-bundle",
    "build:mac": "tauri build --bundles dmg",
    "build:win": "tauri build --bundles nsis",
    "build:win:arm64": "tauri build --bundles nsis --target aarch64-pc-windows-msvc",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.13.0",
    "howler": "^2.2.4",
    "husky": "^9.1.7",
    "leva": "^0.10.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.6",
    "zustand": "^5.0.16"
  }
}
