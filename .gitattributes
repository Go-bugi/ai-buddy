# 모든 OS에서 저장소에는 LF로 저장하고, 체크아웃도 LF로 고정 (Windows autocrlf 무시)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.dmg binary
*.exe binary
*.zip binary
